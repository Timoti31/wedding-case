{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/d/k7q2m",
      "destination": "/api/trap"
    },
    {
      "source": "/x/k7q2m",
      "destination": "/api/trap?panel=1"
    }
  ],
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- ."
}
